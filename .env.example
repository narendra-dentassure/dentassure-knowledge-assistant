# Copy this file to .env and fill in ONE LLM provider.
# Do not commit .env or real API keys.

# openai | gemini
LLM_PROVIDER=gemini

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Retrieval settings (no hard-coded secrets; all overridable)
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVE_K=8
RERANK_K=4
MIN_RELEVANCE_SCORE=0.18
LOG_LEVEL=INFO
DATA_DIR=data/sample_docs
CHROMA_DIR=storage/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# auto = try public DentAssure APIs, then local fixtures
# live = public APIs only
# offline = local fixtures + documents only (works with no public API)
PLATFORM_MODE=auto
DENTASSURE_API_BASE=https://api.dentassureplans.co.in/v1
